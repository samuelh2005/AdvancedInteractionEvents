		"issues": "https://github.com/samuelh2005/AdvancedInteractionEvents/issues"
	},
	"license": "LGPL-3.0-or-later",
	"icon": "assets/advanced_interaction_events/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"me.samuelh2005.advanced_interaction_events.AdvancedInteractionEvents"
		]
	},
	"mixins": [
		"advanced_interaction_events.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.2",
